# ==================================================================
# Dashboard Development Environment
#
# Access the app at: http://localhost:40807
# Models page: http://localhost:40807/models
# pgAdmin: http://localhost:5050
# ==================================================================

# PostgreSQL database via docker compose up
local_resource(
    "postgres",
    cmd = ["docker", "compose", "-f", "environments/dev/docker-compose.yml", "up", "-d", "postgres"],
    dir = "../..",
    labels = ["Database"],
)

# Nuxt dev server (depends on postgres being ready)
local_resource(
    "dev",
    serve_cmd = ["/home/linuxbrew/.linuxbrew/bin/nub", "run", "dev", "--port", "0"],
    serve_dir = "../../src/nuxt",
    labels = ["Frontend"],
    resource_deps = ["postgres"],
    auto_init = True,
)

# pgAdmin - PostgreSQL management tool
local_resource(
    "pgadmin",
    serve_cmd = ["docker", "run", "--rm", "-p", "5050:80", "-e", "PGADMIN_DEFAULT_EMAIL=admin@admin.com", "-e", "PGADMIN_DEFAULT_PASSWORD=admin", "-e", "PGADMIN_CONFIG_SERVER_MODE=False", "dpage/pgadmin4"],
    labels = ["Database"],
    resource_deps = ["postgres"],
    auto_init = False,
)
