# ==================================================================
# Dashboard Development Environment
# ==================================================================

# PostgreSQL database via docker compose up
local_resource(
    "postgres",
    cmd = ["docker", "compose", "-f", "environments/dev/docker-compose.yml", "up", "-d", "postgres"],
    dir = "../..",
    labels = ["Database"],
)

# Nuxt dev server (depends on postgres being ready)
local_resource(
    "dev",
    cmd = ["/home/linuxbrew/.linuxbrew/bin/nub", "run", "dev", "--port", "0"],
    dir = "../../src/nuxt",
    labels = ["Frontend"],
    resource_deps = ["postgres"],
)
