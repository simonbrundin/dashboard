# ==================================================================
# Dashboard Development Environment
#
# Access the app at: http://localhost:40807
# Models page: http://localhost:40807/models
# pg-view: http://localhost:5050
# ==================================================================

# PostgreSQL database via docker compose up
local_resource(
    "postgres",
    cmd = ["docker", "compose", "-f", "environments/dev/docker-compose.yml", "up", "-d", "postgres"],
    dir = "../..",
    labels = ["Database"],
)

# Nuxt dev server (depends on postgres being ready)
local_resource(
    "dev",
    serve_cmd = ["/home/linuxbrew/.linuxbrew/bin/nub", "run", "dev", "--port", "0"],
    serve_dir = "../../src/nuxt",
    labels = ["Frontend"],
    resource_deps = ["postgres"],
    auto_init = True,
    port_forwards = [8080],
)

# pg-view - lightweight PostgreSQL web interface (auto-connects to database)
local_resource(
    "pgview",
    cmd = [
        "docker", "run", "--rm",
        "-p", "5050:3000",
        "-e", "DB_URL=postgresql://postgres:postgres@127.0.0.1:5432/dashboard",
        "--network=host",
        "lcurrol/pg-view"
    ],
    labels = ["Database"],
    resource_deps = ["postgres"],
    auto_init = True,
)
