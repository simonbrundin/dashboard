# ==================================================================
# Dashboard Development Environment
#
# Access the app at: http://localhost:40807
# Models page: http://localhost:40807/models
# Drizzle Studio: http://localhost:49830
# ==================================================================

# PostgreSQL database via docker compose up
local_resource(
    "postgres",
    cmd = ["docker", "compose", "-f", "environments/dev/docker-compose.yml", "up", "-d", "postgres"],
    dir = "../..",
    labels = ["Database"],
)

# Nuxt dev server (depends on postgres being ready)
local_resource(
    "dev",
    serve_cmd = ["/home/linuxbrew/.linuxbrew/bin/nub", "run", "dev", "--port", "0"],
    serve_dir = "../../src/nuxt",
    labels = ["Frontend"],
    resource_deps = ["postgres"],
    auto_init = True,
)

# Drizzle Studio - visual database viewer
# Connects to postgres at localhost:5432 with user postgres/password postgres
local_resource(
    "drizzle-studio",
    serve_cmd = ["npx", "drizzle-kit", "studio", "--config", "src/nuxt/drizzle.config.ts", "--port", "49830", "--host", "0.0.0.0"],
    serve_dir = "../..",
    labels = ["Database"],
    resource_deps = ["postgres"],
    auto_init = False,
)
